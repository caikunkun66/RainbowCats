<wxs module="util" src="../util.wxs" />
<view class="container white" style="animation-name: animation-blur; animation-duration: 0.5s;">
  <image src="../../images/Mission.gif" mode='widthFix' />
  <view class="form-group" style="z-index: 0; box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.05), 0 6px 20px 0 rgba(0, 0, 0, 0.05); ">
    <view class="form-cell">
      <view class="form-cell_title">🔖选择预设</view>
      <picker mode="selector" bindchange="onPresetChange" value="{{presetIndex}}" range="{{presets}}" range-key="name">{{presets[presetIndex].name}}</picker>
    </view>
    <view class="form-cell">
      <view class="form-cell_title">📌任务名称</view>
      <input class="form-cell_input" placeholder="任务名是什么?" placeholder-class="form-cell_placeholder" bindinput="onTitleInput" value="{{title}}" />
    </view>
    <view class="form-cell">
      <view class="form-cell_title">📝任务详情</view>
      <textarea class="form-cell_input" placeholder="任务是要做什么呢?" placeholder-class="form-cell_placeholder" bindinput="onDescInput" value="{{desc}}" />
    </view>
    <view class="form-cell">
      <view class="form-cell_title">👥任务接收人</view>
      <radio-group class="owner-radios" bindchange="onOwnerChange">
        <label class="owner-radio" wx:for="{{ownerOptions}}" wx:key="openid">
          <radio value="{{item.openid}}" checked="{{item.openid === selectedOwnerOpenid}}" />
          <text class="owner-radio_label">{{item.name}}</text>
        </label>
      </radio-group>
    </view>
    <view class="form-cell reminder-cell">
      <view class="reminder-header">
        <view class="form-cell_title">⏰定时提醒</view>
        <switch class="reminder-switch"
                checked="{{remindEnabled}}"
                bindchange="onReminderToggle" />
      </view>
      <view class="reminder-pickers {{remindEnabled ? '' : 'disabled'}}">
        <picker mode="date"
                value="{{remindDate}}"
                start="{{minRemindDate}}"
                disabled="{{!remindEnabled}}"
                bindchange="onReminderDateChange">
          <view class="picker-value">{{remindDate || '选择日期'}}</view>
        </picker>
        <picker mode="time"
                value="{{remindTime}}"
                disabled="{{!remindEnabled}}"
                bindchange="onReminderTimeChange">
          <view class="picker-value">{{remindTime || '选择时间'}}</view>
        </picker>
      </view>
      <view class="reminder-tip">将在指定时间向双方发送完成提醒</view>
    </view>
    <view class="form-cell">
      <view class="form-cell_title">💰积分奖励</view>
      <view class="credit-input-row">
        <slider class="credit-slider" min="0" max="{{maxCredit}}" block-size="15" block-color="#353535" activeColor="#ff5794" bindchange="onCreditInput" value="{{credit}}" show-value/>
        <input class="credit-number-input" type="number" placeholder="积分" placeholder-class="form-cell_placeholder" bindinput="onCreditManualInput" value="{{credit}}" />
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="reset" bindtap="resetMission">重置</view>
    <button class="save {{isSaving ? 'disabled' : ''}}"
            bindtap="handleTap"
            hover-class="none"
            type="default">
      {{isSaving ? '提交中...' : '保存'}}
    </button>
  </view>
</view>